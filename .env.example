# Copy to .env and fill in what you need. Never commit .env.

# --- LLM (optional: only the natural-language box needs it) ---
OPENAI_API_KEY=
# DLC_OPENAI_MODEL=gpt-4.1-mini
# DLC_LLM_PROVIDER=openai

# --- Safety ---
# Read-only by default. Setting this to true relaxes the SQL guard in the backend.
# The reference MCP servers stay read-only regardless. Read SECURITY.md first.
# DLC_ALLOW_WRITE_QUERIES=false

# --- Limits ---
# DLC_MAX_ROWS=1000
# DLC_QUERY_TIMEOUT_SECONDS=30

# --- Optional PostgreSQL demo (docker-compose.postgres.yml) ---
# Pick your own value; it only protects the throwaway demo database.
# POSTGRES_PASSWORD=
# For your own Postgres data source, referenced from config/datasources.json as ${POSTGRES_DSN}:
# POSTGRES_DSN=postgresql://readonly_user:<password>@localhost:5432/mydb

# --- Local development paths (defaults shown; Docker sets its own) ---
# DLC_DATASOURCES_FILE=config/datasources.json
# DLC_WORKFLOWS_DIR=./data/workflows
# DLC_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
